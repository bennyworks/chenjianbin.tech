---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, '');
const linkHref = typeof href === 'string' && href.startsWith('/') ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${href.replace(/^\//, '')}` : href;
---

<a class:list={[className, { 'underline decoration-1 underline-offset-2': isActive }]} href={linkHref} {...props}>
    <slot />
</a>
